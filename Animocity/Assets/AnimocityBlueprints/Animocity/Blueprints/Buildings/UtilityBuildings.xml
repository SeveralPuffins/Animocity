  <BuildingBlueprint label="PowerTap">
    <displayName>Power Tap</displayName>
    <category>bcb_Utility</category>
    <prefabPath>Main/Buildings/Prefabs/PowerTapBuilding</prefabPath>
    <description>Extracts and transforms usable power from an exposed point in the mech.</description>
    <grantsSupport>false</grantsSupport>
    <autoRow>false</autoRow>
    <tilesNeeded>
      <li>0,0</li>
    </tilesNeeded>
    <components>
      <li Class="BuildingComponentData_Power">
        <componentClass>Animocity.Cities.BuildingComponent_PowerSupplier</componentClass>
        <powerAmount>200.0</powerAmount>
    </li>
    </components>
    <buildRequirements>
      <li>BuildRequirementBlue_IsOnCoil</li>
    </buildRequirements>
    <resourceCosts>
      <di>
        <dk>Iron</dk>
        <dv>18.0</dv>
      </di>
      <di>
        <dk>Copper</dk>
        <dv>12.0</dv>
      </di>
    </resourceCosts>
  </BuildingBlueprint>
  
  
