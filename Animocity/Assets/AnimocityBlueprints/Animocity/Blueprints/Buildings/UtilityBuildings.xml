<?xml version="1.0" encoding="utf-8" ?>
<Buildings>
  
  <BuildingBlueprint label="PowerTap">
    <displayName>Power Tap</displayName>
    <category>bcb_Utility</category>
    <prefabPath>Main/Buildings/Prefabs/PowerTapBuilding</prefabPath>
    <description>Extracts and transforms usable power from an exposed point in the mech.</description>
    <grantsSupport>false</grantsSupport>
    <autoRow>false</autoRow>
    <tilesNeeded>
      <li>0,0</li>
    </tilesNeeded>
    <components>
      <li Class="BuildingComponentData_Power">
        <componentClass>Animocity.Cities.BuildingComponent_PowerSupplier</componentClass>
        <powerAmount>200.0</powerAmount>
    </li>
    </components>
    <buildRequirements>
      <li>BuildRequirementBlue_IsOnCoil</li>
    </buildRequirements>
  </BuildingBlueprint>


  <BuildingBlueprint label="PowerCoil">
    <displayName>Power Coil</displayName>
    <category>bcb_Utility</category>
    <prefabPath>Main/Buildings/Prefabs/PowerCoil</prefabPath>
    <description>Exposed meta-alloy conduits allow us to tap a small amount of power from the mech's chassis.</description>
    <grantsSupport>false</grantsSupport>
    <autoRow>false</autoRow>
    <tilesNeeded>
      <li>0,0</li>
    </tilesNeeded>
    <buildRequirements>
      <li>BuildRequirementBlue_Fits</li>
      <li>BuildRequirementBlue_IsSupported</li>
    </buildRequirements>
  </BuildingBlueprint>

  <BuildingBlueprint label="Gantry">
    <displayName>Gantry</displayName>
    <category>bcb_Utility</category>
    <prefabPath>Main/Buildings/Prefabs/Gantry</prefabPath>
    <description>Cheap, utilitarian transit. Grants support and access to buildings.</description>
    <grantsSupport>true</grantsSupport>
    <autoRow>true</autoRow>
    <tilesNeeded>
      <li>0,0</li>
    </tilesNeeded>
    <buildRequirements>
      <li>BuildRequirementBlue_Fits</li>
    </buildRequirements>
    <components>
      <li Class="BuildingComponentData_Transport">
        <componentClass>Animocity.Cities.BuildingComponent_Transport</componentClass>
        <transitCost>0.05</transitCost>
      </li>
    </components>
  </BuildingBlueprint>
</Buildings>